# Copy to .env (never commit .env).  cp .env.example .env

# --- Database (Docker `make db` exposes PostGIS on port 5433) ---
DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5433/civicflow
TEST_DATABASE_URL=postgresql+psycopg://civic:civic@localhost:5433/civicflow_test

# --- Security (change these to long random strings) ---
JWT_SECRET=change-me
MEDIA_URL_SECRET=change-me-too
CORS_ORIGINS=http://localhost:5173

# --- First accounts created by `make seed` (never shown on any page) ---
SEED_ADMIN_MOBILE=9000000001
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# --- Ingestion API keys (one per data source) ---
INGEST_KEY_OEM_SIM=
INGEST_KEY_WEATHER=

# --- Weather (Open-Meteo, no key needed) ---
WEATHER_LAT=12.9081
WEATHER_LON=77.4874

# --- Agents ---
AGENT_MODE=rules            # live | record | replay | rules
TIME_SCALE=1                # tests only

# --- LLM providers: tried in order, then rules. Any OpenAI-compatible API works. ---
LLM_PROVIDERS=gemini,groq
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GEMINI_VISION=true
LLM_GEMINI_TOOLS=native
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_GROQ_VISION=false
LLM_GROQ_TOOLS=native
# Optional local model (needs Ollama running):
# LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_OLLAMA_MODEL=llama3.1
# LLM_OLLAMA_TOOLS=json

# --- Simulator / web ---
API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE=http://localhost:8000/api/v1
